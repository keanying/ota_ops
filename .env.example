# =============================================================================
# 敏感信息通过环境变量注入，不要把真实账号密码写进 YAML 或提交到仓库
#
# 本文件复制为 .env 后，程序会【自动加载】，无需 source / export：
#   Windows PowerShell:  Copy-Item .env.example .env ; notepad .env
#   Linux / macOS:       cp .env.example .env && vim .env
#
# 填完后执行 python -m ctrip.cli doctor 可逐项确认是否已生效。
#
# 注意：
#   * 等号两边不要加空格（KEY=value，不是 KEY = value）
#   * 密码含 @ : # 等特殊字符时直接写原文，不需要转义、不需要加引号
#   * 已存在的真实环境变量优先于本文件，便于 CI 临时覆盖
# =============================================================================

# ---------- MySQL（不配置则只写 CSV） ----------
MYSQL_HOST=127.0.0.1
MYSQL_USER=ctrip
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=ctrip_data

# ---------- 携程账号（每个账号一组） ----------
# 账号与密码必填（status=active 的账号）。
# scenic_id 为景区ID（如 PFTSCA01018088），账号级绑定，不属于敏感信息，
# 也可直接写在 config/config.yaml 里，这里仅供统一由环境变量管理时使用。
#
# 若账号密码统一存在数据库，可改用数据库账号源，此处只需保留 MySQL 连接信息：
#   config.yaml -> mysql.enabled: true 且 ctrip.account_source: mysql
CTRIP_A001_ACCOUNT=vbk_569202
CTRIP_A001_PASSWORD=change_me
CTRIP_A001_SCENIC_ID=PFTSCA01018088

CTRIP_A002_ACCOUNT=
CTRIP_A002_PASSWORD=
CTRIP_A002_SCENIC_ID=

CTRIP_A003_ACCOUNT=
CTRIP_A003_PASSWORD=
CTRIP_A003_SCENIC_ID=

# ---------- 可选：容器/CI 中直接内联账号列表 ----------
# 格式 account_id:account:password[:scenic_id]，多个用逗号分隔（优先级高于 YAML）
# CTRIP_ACCOUNTS=A001:vbk_569202:pwd1:PFTSCA01018088,A002:vbk_778001:pwd2:PFTSCA01029177

# ---------- 可选：任意配置项覆盖，规则 CTRIP__<段>__<键> ----------
# CTRIP__RUN__SINK=both
# CTRIP__MYSQL__ENABLED=true
# CTRIP__RUN__WORKERS=2
# CTRIP__CTRIP__ACCOUNT_SOURCE=mysql
